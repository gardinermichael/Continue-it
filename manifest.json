{
  "manifest_version": 3,
  "name": "Continue it",
  "version": "0.7.0",
  "description": "Migrate conversation context between Claude, ChatGPT, Gemini, Grok, Perplexity, and more with long-chat support.",
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite", "contextMenus"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Continue it",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["provider-config.js", "shared-handoff.js", "shared-ai.js", "shared-ui.js", "content-site.js"],
      "run_at": "document_idle"
    }
  ]
}
